# VoiceCare Backend Environment Variables
# Copy this file to .env and add your real Gemini API key.

# Port the backend server runs on
PORT=3000

# Your Google Gemini API key from https://aistudio.google.com/apikey
# NEVER put this key inside frontend JavaScript files!
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use. Google frequently reports "high demand" (503) for a single
# model, so VoiceCare automatically falls through this list until one answers.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-3.7-flash,gemini-3.5-flash,gemini-flash-latest

# Set to true to allow offline/demo fallback summaries when GEMINI_API_KEY is not set yet.
# Set to false in production so all requests require a real Gemini API key.
ALLOW_DEMO_FALLBACK=true

# Comma-separated list of allowed frontend origins (leave * for local & Capacitor mobile testing)
ALLOWED_ORIGINS=*
